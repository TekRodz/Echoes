{
  "name": "echos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config cadran/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build && node scripts/build-artifact.mjs",
    "cadran:dev": "vite --config cadran/vite.config.ts",
    "cadran:build": "tsc --noEmit && vite build --config cadran/vite.config.ts",
    "cadran:test": "vitest run --config cadran/vite.config.ts",
    "cadran:artifact": "npm run cadran:build && node scripts/build-artifact.mjs dist-cadran cadran.html Cadran"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
